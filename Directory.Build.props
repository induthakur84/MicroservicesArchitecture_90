<Project>
  <PropertyGroup>
    <!-- Suppress NuGet Audit warnings so they do not fail Package Manager Console or CI builds -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Update transitive package to safe version -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
  </ItemGroup>
</Project>
